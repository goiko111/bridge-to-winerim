name = "winerim-runtime-credential-provisioner"
main = "{{RUNTIME_CREDENTIAL_PROVISIONER_MAIN}}"
compatibility_date = "2026-06-12"
compatibility_flags = ["nodejs_compat"]
workers_dev = false
preview_urls = false

[vars]
PROVISIONING_ENABLED = "false"
CF_ACCESS_AUD = "{{CF_ACCESS_AUD}}"
CF_ACCESS_TEAM_DOMAIN = "https://{{CF_ACCESS_TEAM_DOMAIN}}"
# Cloudflare can round a 15-minute service-token JWT to 901 seconds.
ACCESS_MAX_TOKEN_TTL_SECONDS = "960"
OPERATOR_KEY_ID = "{{OPERATOR_KEY_ID}}"
OPERATOR_PUBLIC_KEY_JWK = '''{{OPERATOR_PUBLIC_KEY_JWK}}'''
CHALLENGE_TTL_SECONDS = "90"
RUNTIME_VAULT_KEY_VERSION = "{{RUNTIME_VAULT_KEY_VERSION}}"

[[secrets_store_secrets]]
binding = "RUNTIME_VAULT_KEY"
store_id = "{{CLOUDFLARE_RUNTIME_VAULT_STORE_ID}}"
secret_name = "{{CLOUDFLARE_RUNTIME_VAULT_SECRET_NAME}}"

[[durable_objects.bindings]]
name = "RUNTIME_CREDENTIAL_CHALLENGES"
class_name = "RuntimeCredentialChallenge"

[[migrations]]
tag = "v1"
new_sqlite_classes = ["RuntimeCredentialChallenge"]

[[routes]]
pattern = "{{RUNTIME_CREDENTIAL_PROVISIONER_CUSTOM_DOMAIN}}"
custom_domain = true

# Add the custom domain only after Cloudflare Access has either an MFA Allow
# policy or a narrowly scoped Service Auth policy. Access must inject a signed
# application JWT with a maximum 15-minute TTL; the Worker verifies that JWT.
# Keep PROVISIONING_ENABLED=false until the bounded provisioning window opens.
