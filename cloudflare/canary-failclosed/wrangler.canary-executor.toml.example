# TEMPLATE ONLY. Private service: no route, workers.dev or preview URL.
name = "{{RUNTIME_EXECUTOR_SERVICE_NAME}}"
main = "cloudflare/workers/middleware-runtime-executor/src/worker.ts"
compatibility_date = "2026-06-12"
compatibility_flags = ["nodejs_compat"]
workers_dev = false
preview_urls = false

[vars]
ENVIRONMENT = "rescue-production"
RUNTIME_MODE = "exclusive-canary-executor"
RELEASE = "{{RELEASE}}"
RUNTIME_EXECUTION_ENABLED = "true"
RUNTIME_SALES_EXECUTION_ENABLED = "false"
RUNTIME_SALES_CURSOR_ENABLED = "false"
RUNTIME_SALES_DLQ_READY = "false"
RUNTIME_CANARY_CONNECTION_ID = "{{CANARY_CONNECTION_ID}}"
CANARY_RUN_ID = "{{CANARY_RUN_ID}}"
WRITER_FENCE_HOLDER_ID = "{{WRITER_FENCE_HOLDER_ID}}"
CANARY_EXCLUSIVE_CREDENTIAL_VERSION = "{{CANARY_EXCLUSIVE_CREDENTIAL_VERSION}}"
RUNTIME_VAULT_KEY_VERSION = "{{RUNTIME_VAULT_KEY_VERSION}}"
WINERIM_API_BASE_URL = "https://app.winerim.com"
WINERIM_ALLOWED_HOSTS = "app.winerim.com"

[[hyperdrive]]
binding = "MIDDLEWARE_DB"
id = "{{RUNTIME_HYPERDRIVE_ID}}"

[[secrets_store_secrets]]
binding = "RUNTIME_VAULT_KEY"
store_id = "{{RUNTIME_VAULT_STORE_ID}}"
secret_name = "{{RUNTIME_VAULT_SECRET_NAME}}"

[[services]]
binding = "WRITER_FENCE"
service = "{{WRITER_FENCE_SERVICE_NAME}}"

[[secrets_store_secrets]]
binding = "CANARY_WRITER_FENCE_PROOF"
store_id = "{{WRITER_FENCE_PROOF_STORE_ID}}"
secret_name = "{{WRITER_FENCE_PROOF_SECRET_NAME}}"
