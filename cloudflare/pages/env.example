# Cloudflare Pages / local frontend
# No poner secretos aqui.

VITE_MIDDLEWARE_API_URL=http://localhost:8787

# El Worker mantiene la bandeja de solicitudes apagada por defecto.
# Activarla requiere Cloudflare Access y secrets en el Worker, no variables Vite.

# Staging:
# VITE_MIDDLEWARE_API_URL=https://api-staging.middleware.winerim.wine

# Production:
# VITE_MIDDLEWARE_API_URL=https://api.middleware.winerim.wine
