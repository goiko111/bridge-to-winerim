name = "winerim-middleware-runtime-executor-canary"
main = "cloudflare/workers/middleware-runtime-executor/src/worker.ts"
compatibility_date = "2026-06-12"
compatibility_flags = ["nodejs_compat"]
workers_dev = false

[env.staging]
name = "winerim-middleware-runtime-executor-canary-staging"
workers_dev = false

[env.staging.vars]
ENVIRONMENT = "staging"
RELEASE = "staging-live-glass-canary"
RUNTIME_EXECUTION_ENABLED = "true"
RUNTIME_CANARY_CONNECTION_ID = "{{RUNTIME_CANARY_CONNECTION_ID}}"
RUNTIME_VAULT_KEY_VERSION = "v1"
WINERIM_API_BASE_URL = "https://app.winerim.com"
WINERIM_ALLOWED_HOSTS = "app.winerim.com"

[[env.staging.hyperdrive]]
binding = "MIDDLEWARE_DB"
id = "0adae4108e4241f19cf5ba2709cbc69f"

[[env.staging.secrets_store_secrets]]
binding = "RUNTIME_VAULT_KEY"
store_id = "{{CLOUDFLARE_RUNTIME_VAULT_STORE_ID}}"
secret_name = "{{CLOUDFLARE_RUNTIME_VAULT_SECRET_NAME}}"
