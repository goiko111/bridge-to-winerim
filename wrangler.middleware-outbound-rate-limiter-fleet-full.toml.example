name = "winerim-middleware-outbound-rate-limiter-rescue-prod-fleet"
main = "cloudflare/workers/middleware-outbound-rate-limiter/src/worker.ts"
compatibility_date = "2026-06-12"
compatibility_flags = ["nodejs_compat"]
workers_dev = false
preview_urls = false

[vars]
ENVIRONMENT = "rescue-production"
RELEASE = "fleet-full-inactive-__SOURCE_COMMIT_SHA__"

[[durable_objects.bindings]]
name = "OUTBOUND_RATE_LIMITER"
class_name = "OutboundRateLimiter"

[[migrations]]
tag = "v1"
new_sqlite_classes = ["OutboundRateLimiter"]

# Inert by reachability: no public route, preview URL or workers.dev endpoint exists.
